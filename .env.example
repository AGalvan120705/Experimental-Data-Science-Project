# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Used only by the FastAPI service. Never expose this in a VITE_ variable.
GEMINI_API_KEY=

# Optional: change the model without a code release.
GEMINI_MODEL=gemini-flash-latest

# SQLite file used to cache one response per ward, dataset version and UTC day.
WARD_SUMMARY_CACHE_DB=src/Data/ward_summary_cache.sqlite3
